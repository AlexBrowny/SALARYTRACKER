# ==========================================
# Переменные окружения для Vercel и Turso
# ==========================================

# 1. Turso Database (LibSQL)
# Укажите в панели Vercel (Project Settings -> Environment Variables)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# 2. JWT Secret
JWT_SECRET=your-secure-random-secret-key-at-least-32-chars
