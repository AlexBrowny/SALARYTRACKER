{
  "name": "salary-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Salary Tracker - Personal finance tracker (React + Express + Turso + Vercel)",
  "type": "module",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "migrate:turso": "cd server && node src/db/migrate-to-turso.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.3"
  }
}
