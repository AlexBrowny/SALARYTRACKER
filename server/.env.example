# Подключение к облачной базе данных Turso (LibSQL)
# Получите из панели Turso (turso db show --url <dbname> / turso db tokens create <dbname>)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# Секретный ключ для JWT авторизации
JWT_SECRET=your-secret-key-change-this-in-production

# Порт локального сервера (по умолчанию 3001)
PORT=3001
